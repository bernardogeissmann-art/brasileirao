# Modelo do arquivo .env (este modelo pode ir para o git; o .env de verdade, não).
# 1. Copie este arquivo e renomeie a cópia para .env
# 2. Troque o texto depois de cada "=" pela sua chave (sem aspas, sem espaços)

# Chave do football-data.org (jogos do Brasileirão)
FOOTBALL_DATA_API_KEY=coloque_sua_chave_aqui

# Chave da Anthropic (IA que escreve o texto da página Meu Time). Crie em platform.claude.com.
# Se ficar sem ela, o texto sai com as frases prontas.
ANTHROPIC_API_KEY=coloque_sua_chave_aqui
